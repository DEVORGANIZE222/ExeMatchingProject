        </mxCell>
        <mxCell id="p04-m8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;Gateway + SharedKernel&lt;/span&gt;&lt;ul style=&quot;margin:6px 0 0 -18px&quot;&gt;&lt;li&gt;&lt;code&gt;Path routing, CORS, rate limit 30 r/s&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;GET / and /health&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Swagger UI at each API root&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Global exception → JSON&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Schema + seed at startup&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;i style=&quot;color:#555&quot;&gt;nginx.conf, GlobalExceptionHandler, Program.cs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p04-1">
