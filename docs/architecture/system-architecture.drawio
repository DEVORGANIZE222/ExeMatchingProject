        </mxCell>
        <mxCell id="p09-auto12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;• React 19.2, React DOM 19.2, Vite 8.3, @vitejs/plugin-react 6.1, Oxlint 1.81 — default template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="p09-1">
