        <mxCell id="p01-sys" parent="p01-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;arcSize=6;fontSize=11;" value="&lt;b&gt;EXE Team Matching System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Nginx gateway + 3 ASP.NET Core APIs (IdentitySemester, GroupMatching, Mentor) + Notification worker, PostgreSQL, Kafka&lt;/span&gt;" vertex="1">
