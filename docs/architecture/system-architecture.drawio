        </mxCell>
        <mxCell id="p04-m5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mentor Management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;Mentor API (REST)&lt;/span&gt;&lt;ul style=&quot;margin:6px 0 0 -18px&quot;&gt;&lt;li&gt;&lt;code&gt;GET /api/mentors&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;GET /api/mentors/{id}&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;GET /api/mentors/{id}/quota&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;POST /api/mentor-requests&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;POST /api/mentor-requests/decision&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;i style=&quot;color:#555&quot;&gt;Mentors/MentorQuotas/MentorRequests + seed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p04-1">
