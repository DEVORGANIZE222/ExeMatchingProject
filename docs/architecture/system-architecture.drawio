        <mxCell id="p09-auto3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;• .NET 8 (net8.0) — Directory.Build.props&lt;br&gt;• ASP.NET Core Web API — 3 APIs&lt;br&gt;• .NET Worker Service (Microsoft.Extensions.Hosting 8.0.0) — Notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p09-1">
