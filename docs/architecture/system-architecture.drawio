  <diagram id="p03" name="03 - Main Actors">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="p03-0" />
        <mxCell id="p03-1" parent="p03-0" />
        <mxCell id="p03-auto1" value="03 · Main Actors" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1F2D3D;whiteSpace=wrap;" vertex="1" parent="p03-1">
          <mxGeometry x="30" y="16" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p03-auto2" value="Only actors with direct evidence. Role enforcement is NOT implemented — mappings below are what the endpoints/DTOs are designed for." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="p03-1">
          <mxGeometry x="30" y="52" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p03-a0" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;resizable=0;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="p03-1">
          <mxGeometry x="190" y="110" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p03-c0" value="&lt;b&gt;Role:&lt;/b&gt; Capstone/EXE course participant&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsibilities / capabilities:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 -18px&quot;&gt;&lt;li&gt;Log in (skeleton)&lt;/li&gt;&lt;li&gt;Create a group / join / leave (stub)&lt;/li&gt;&lt;li&gt;Vote for group leader (VoteLeaderRequest.VoterStudentId)&lt;/li&gt;&lt;li&gt;Request a mentor for the group (stub)&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Relationship with system:&lt;/b&gt; Primary user; referenced by GroupMember.StudentId, Group.LeaderStudentId, LeaderVote, GroupInvitation&lt;br&gt;&lt;br&gt;&lt;i&gt;Evidence:&lt;/i&gt; Seeded Role &#39;Student&#39; (IdentitySemesterDbContext); Student entity linked to User and Semester" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p03-1">
          <mxGeometry x="40" y="310" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p03-a1" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;resizable=0;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="p03-1">
          <mxGeometry x="720" y="110" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p03-c1" value="&lt;b&gt;Role:&lt;/b&gt; Course / system administrator&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsibilities / capabilities:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 -18px&quot;&gt;&lt;li&gt;Import students for a semester (stub)&lt;/li&gt;&lt;li&gt;Create / list semesters (stub)&lt;/li&gt;&lt;li&gt;Trigger random matching (stub)&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Relationship with system:&lt;/b&gt; Admin-only restriction is Not verified from source (no [Authorize])&lt;br&gt;&lt;br&gt;&lt;i&gt;Evidence:&lt;/i&gt; Seeded Role &#39;Admin&#39; — &#39;System Administrator&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p03-1">
          <mxGeometry x="570" y="310" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p03-a2" value="&lt;b&gt;Mentor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;resizable=0;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="p03-1">
          <mxGeometry x="1250" y="110" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p03-c2" value="&lt;b&gt;Role:&lt;/b&gt; Lecturer mentoring EXE groups&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsibilities / capabilities:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 -18px&quot;&gt;&lt;li&gt;Receive mentor requests from groups&lt;/li&gt;&lt;li&gt;Accept / reject with reason (stub)&lt;/li&gt;&lt;li&gt;Has quota MaxQuota / CurrentAssigned&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Relationship with system:&lt;/b&gt; No &#39;Mentor&#39; role is seeded in Roles — how mentors log in is Not verified&lt;br&gt;&lt;br&gt;&lt;i&gt;Evidence:&lt;/i&gt; MentorUser entity (Mentors table) with UserId; MentorDecisionDto; seed &#39;Dr. Le Van C&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p03-1">
          <mxGeometry x="1100" y="310" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p03-auto3" value="&lt;b&gt;Not an actor in code:&lt;/b&gt; no external identity provider, no mentor-facing or admin-facing UI (frontend is the default Vite template). Seeded demo user: student01 / SE160001 (PasswordHash is a placeholder string)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="p03-1">
          <mxGeometry x="40" y="670" width="1560" height="50" as="geometry" />
        </mxCell>
      </root>
