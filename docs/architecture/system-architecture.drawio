          <mxGeometry x="1470" y="380" width="120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p04-m6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mentor gRPC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;Mentor API (gRPC)&lt;/span&gt;&lt;ul style=&quot;margin:6px 0 0 -18px&quot;&gt;&lt;li&gt;&lt;code&gt;MentorGrpcService.GetMentor&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;GetMentors&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;GetMentorQuota&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;i style=&quot;color:#555&quot;&gt;Hard-coded response; no client; port 50051 not bound by Kestrel config&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p04-1">
          <mxGeometry x="40" y="640" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p04-auto9" value="Mock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontStyle=1;" vertex="1" parent="p04-1">
          <mxGeometry x="410" y="650" width="120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p04-m7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;Notification Worker&lt;/span&gt;&lt;ul style=&quot;margin:6px 0 0 -18px&quot;&gt;&lt;li&gt;&lt;code&gt;Consume 7 domain events&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Send e-mail via SMTP&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;i style=&quot;color:#555&quot;&gt;Worker loops with TODO; EmailService logs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p04-1">
