        <mxCell id="p04-m3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Leader Voting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;GroupMatching API&lt;/span&gt;&lt;ul style=&quot;margin:6px 0 0 -18px&quot;&gt;&lt;li&gt;&lt;code&gt;POST /api/groups/{id}/vote-leader&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;i style=&quot;color:#555&quot;&gt;LeaderVotes table + seed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p04-1">
