        </mxCell>
        <mxCell id="p09-auto14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Deployment&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Docker multi-stage (dotnet/sdk:8.0 → aspnet:8.0 / runtime:8.0)&lt;br&gt;• docker-compose.yml (local)&lt;br&gt;• render.yaml (Render, singapore, free plan)&lt;br&gt;• CI/CD: none found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p09-1">
