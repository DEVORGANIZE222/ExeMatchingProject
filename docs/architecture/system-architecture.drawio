        <mxCell id="p09-auto13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Testing&lt;/b&gt;&lt;br&gt;&lt;br&gt;• xUnit 2.6.6, Microsoft.NET.Test.Sdk 17.9, Microsoft.AspNetCore.Mvc.Testing 8.0.2&lt;br&gt;• 4 test projects, each 1 placeholder Assert.True(true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;" vertex="1" parent="p09-1">
