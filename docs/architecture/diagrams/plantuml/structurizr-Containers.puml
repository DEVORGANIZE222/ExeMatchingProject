@startuml
title <size:24>Container View: EXE Team Matching System</size>\n<size:24>C4 Level 2 — Containers</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Student, "Student", $descr="Capstone/EXE student. Seeded role 'Student'. Forms/joins groups, votes for a leader, requests a mentor (all endpoints are Phase 2 stubs).", $tags="", $link="")
Person(Admin, "Admin", $descr="Seeded role 'System Administrator'. Role-to-endpoint mapping is NOT enforced (no authorization configured).", $tags="", $link="")
Person(Mentor, "Mentor", $descr="Lecturer modelled as MentorUser with a quota. Accepts/rejects mentor requests (stub). No 'Mentor' role seeded.", $tags="", $link="")
System(SMTPEmailServer, "SMTP Email Server", $descr="Configured via EmailSettings (default smtp.gmail.com:587). EmailService only logs; no SMTP client is used.", $tags="", $link="")

System_Boundary("EXETeamMatchingSystem_boundary", "EXE Team Matching System", $tags="") {
  Container(EXETeamMatchingSystem.GroupMatchingAPI, "GroupMatching API", $techn="ASP.NET Core 8 Web API", $descr="Groups, members, leader vote, lock, random matching. All endpoints throw NotImplementedException (HTTP 501).", $tags="", $link="")
  Container(EXETeamMatchingSystem.MentorAPI, "Mentor API", $techn="ASP.NET Core 8 Web API + gRPC", $descr="Mentor list/detail/quota and mentor requests/decisions over REST (stubs), plus a gRPC service returning hard-coded data.", $tags="", $link="")
  Container(EXETeamMatchingSystem.NotificationWorker, "Notification Worker", $techn=".NET 8 Worker Service", $descr="Background worker intended to consume Kafka events and send email. Currently loops with Task.Delay(5000) (TODO).", $tags="", $link="")
  ContainerDb(EXETeamMatchingSystem.identity_db, "identity_db", $techn="PostgreSQL 16", $descr="Tables: Users, Roles, Students, Semesters.", $tags="", $link="")
  ContainerDb(EXETeamMatchingSystem.group_matching_db, "group_matching_db", $techn="PostgreSQL 16", $descr="Tables: Groups, GroupMembers, GroupInvitations, LeaderVotes.", $tags="", $link="")
  ContainerDb(EXETeamMatchingSystem.mentor_db, "mentor_db", $techn="PostgreSQL 16", $descr="Tables: Mentors, MentorQuotas, MentorRequests.", $tags="", $link="")
  ContainerQueue(EXETeamMatchingSystem.KafkaBroker, "Kafka Broker", $techn="Apache Kafka (cp-kafka 7.5.0)", $descr="Event broker provisioned in docker-compose (with Zookeeper). No code actually produces or consumes messages.", $tags="", $link="")
  ContainerDb(EXETeamMatchingSystem.Redis, "Redis", $techn="Redis 7 (redis:7-alpine)", $descr="Provisioned in docker-compose only. No service references Redis.", $tags="", $link="")
  Container(EXETeamMatchingSystem.FrontendVitetemplate, "Frontend (Vite template)", $techn="React 19, Vite 8", $descr="Default React + Vite starter page. Makes no API calls and is not part of docker-compose.", $tags="", $link="")
  Container(EXETeamMatchingSystem.APIGateway, "API Gateway", $techn="Nginx (nginx:alpine)", $descr="Single HTTP entry point. Path-based reverse proxy, CORS, rate limiting (30 r/s, burst 50), security headers, gzip, /health.", $tags="", $link="")
  Container(EXETeamMatchingSystem.IdentitySemesterAPI, "IdentitySemester API", $techn="ASP.NET Core 8 Web API", $descr="Auth (login), student import/query, semester management. Login returns a hard-coded skeleton token; other endpoints throw NotImplementedException (HTTP 501).", $tags="", $link="")
}

Rel(Student, EXETeamMatchingSystem.FrontendVitetemplate, "Opens (template page only)", $techn="HTTPS / browser", $tags="", $link="")
Rel(Student, EXETeamMatchingSystem.APIGateway, "Calls REST API (login, groups, votes, mentor requests)", $techn="HTTP/JSON", $tags="", $link="")
Rel(Admin, EXETeamMatchingSystem.APIGateway, "Calls REST API (student import, semesters, random matching)", $techn="HTTP/JSON", $tags="", $link="")
Rel(Mentor, EXETeamMatchingSystem.APIGateway, "Calls REST API (mentor requests & decisions)", $techn="HTTP/JSON", $tags="", $link="")
Rel(EXETeamMatchingSystem.APIGateway, EXETeamMatchingSystem.IdentitySemesterAPI, "Proxies /api/auth, /api/students, /api/semesters", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(EXETeamMatchingSystem.APIGateway, EXETeamMatchingSystem.GroupMatchingAPI, "Proxies /api/groups, /api/matching", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(EXETeamMatchingSystem.APIGateway, EXETeamMatchingSystem.MentorAPI, "Proxies /api/mentors, /api/mentor-requests", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(EXETeamMatchingSystem.IdentitySemesterAPI, EXETeamMatchingSystem.identity_db, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(EXETeamMatchingSystem.GroupMatchingAPI, EXETeamMatchingSystem.group_matching_db, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(EXETeamMatchingSystem.MentorAPI, EXETeamMatchingSystem.mentor_db, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(EXETeamMatchingSystem.IdentitySemesterAPI, EXETeamMatchingSystem.KafkaBroker, "Intended to publish StudentImportedEvent (publisher logs only; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(EXETeamMatchingSystem.GroupMatchingAPI, EXETeamMatchingSystem.KafkaBroker, "Intended to publish Group*/Leader/Topic events (stub; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(EXETeamMatchingSystem.MentorAPI, EXETeamMatchingSystem.KafkaBroker, "Intended to publish Mentor* events (stub; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(EXETeamMatchingSystem.NotificationWorker, EXETeamMatchingSystem.KafkaBroker, "Intended to consume events (TODO; no connection made)", $techn="Kafka (stub)", $tags="", $link="")
Rel(EXETeamMatchingSystem.NotificationWorker, SMTPEmailServer, "Intended to send notification emails (EmailService logs only)", $techn="SMTP :587 (configured)", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml