@startuml
title <size:24>Deployment View: EXE Team Matching System - Docker Compose (local)</size>\n<size:24>Local deployment via docker-compose.yml</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(DockerComposelocal.Dockerhost, "Docker host", $type="Docker Compose", $descr="docker-compose.yml, bridge network capstone-network", $tags="", $link="") {
  Deployment_Node(DockerComposelocal.Dockerhost.exeidentitysemester, "exe-identity-semester", $type="mcr.microsoft.com/dotnet/aspnet:8.0", $descr="Port 5001 → 8080", $tags="", $link="") {
    Container(DockerComposelocal.Dockerhost.exeidentitysemester.IdentitySemesterAPI_1, "IdentitySemester API", $techn="ASP.NET Core 8 Web API", $descr="Auth (login), student import/query, semester management. Login returns a hard-coded skeleton token; other endpoints throw NotImplementedException (HTTP 501).", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exegroupmatching, "exe-group-matching", $type="mcr.microsoft.com/dotnet/aspnet:8.0", $descr="Port 5002 → 8080", $tags="", $link="") {
    Container(DockerComposelocal.Dockerhost.exegroupmatching.GroupMatchingAPI_1, "GroupMatching API", $techn="ASP.NET Core 8 Web API", $descr="Groups, members, leader vote, lock, random matching. All endpoints throw NotImplementedException (HTTP 501).", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exementor, "exe-mentor", $type="mcr.microsoft.com/dotnet/aspnet:8.0", $descr="Ports 5003 → 8080, 50051 → 50051", $tags="", $link="") {
    Container(DockerComposelocal.Dockerhost.exementor.MentorAPI_1, "Mentor API", $techn="ASP.NET Core 8 Web API + gRPC", $descr="Mentor list/detail/quota and mentor requests/decisions over REST (stubs), plus a gRPC service returning hard-coded data.", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exenotificationworker, "exe-notification-worker", $type="mcr.microsoft.com/dotnet/runtime:8.0", $descr="No published ports", $tags="", $link="") {
    Container(DockerComposelocal.Dockerhost.exenotificationworker.NotificationWorker_1, "Notification Worker", $techn=".NET 8 Worker Service", $descr="Background worker intended to consume Kafka events and send email. Currently loops with Task.Delay(5000) (TODO).", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exepostgres, "exe-postgres", $type="postgres:16-alpine", $descr="Port 5432; volume postgres-data; init-databases.sql creates the 3 DBs", $tags="", $link="") {
    ContainerDb(DockerComposelocal.Dockerhost.exepostgres.identity_db_1, "identity_db", $techn="PostgreSQL 16", $descr="Tables: Users, Roles, Students, Semesters.", $tags="", $link="")
    ContainerDb(DockerComposelocal.Dockerhost.exepostgres.group_matching_db_1, "group_matching_db", $techn="PostgreSQL 16", $descr="Tables: Groups, GroupMembers, GroupInvitations, LeaderVotes.", $tags="", $link="")
    ContainerDb(DockerComposelocal.Dockerhost.exepostgres.mentor_db_1, "mentor_db", $techn="PostgreSQL 16", $descr="Tables: Mentors, MentorQuotas, MentorRequests.", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exekafka, "exe-kafka", $type="confluentinc/cp-kafka:7.5.0", $descr="Ports 9092 (host) / 29092 (internal)", $tags="", $link="") {
    ContainerQueue(DockerComposelocal.Dockerhost.exekafka.KafkaBroker_1, "Kafka Broker", $techn="Apache Kafka (cp-kafka 7.5.0)", $descr="Event broker provisioned in docker-compose (with Zookeeper). No code actually produces or consumes messages.", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exezookeeper, "exe-zookeeper", $type="confluentinc/cp-zookeeper:7.5.0", $descr="Client port 2181", $tags="", $link="") {
    Deployment_Node(DockerComposelocal.Dockerhost.exezookeeper.Zookeeper, "Zookeeper", $type="Apache Zookeeper", $descr="Kafka cluster coordination", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exeredis, "exe-redis", $type="redis:7-alpine", $descr="Port 6379; volume redis-data", $tags="", $link="") {
    ContainerDb(DockerComposelocal.Dockerhost.exeredis.Redis_1, "Redis", $techn="Redis 7 (redis:7-alpine)", $descr="Provisioned in docker-compose only. No service references Redis.", $tags="", $link="")
  }

  Deployment_Node(DockerComposelocal.Dockerhost.exenginxgateway, "exe-nginx-gateway", $type="nginx:alpine", $descr="Host port 8080 (GATEWAY_PORT) → 80", $tags="", $link="") {
    Container(DockerComposelocal.Dockerhost.exenginxgateway.APIGateway_1, "API Gateway", $techn="Nginx (nginx:alpine)", $descr="Single HTTP entry point. Path-based reverse proxy, CORS, rate limiting (30 r/s, burst 50), security headers, gzip, /health.", $tags="", $link="")
  }

}

Rel(DockerComposelocal.Dockerhost.exenginxgateway.APIGateway_1, DockerComposelocal.Dockerhost.exeidentitysemester.IdentitySemesterAPI_1, "Proxies /api/auth, /api/students, /api/semesters", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exenginxgateway.APIGateway_1, DockerComposelocal.Dockerhost.exegroupmatching.GroupMatchingAPI_1, "Proxies /api/groups, /api/matching", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exenginxgateway.APIGateway_1, DockerComposelocal.Dockerhost.exementor.MentorAPI_1, "Proxies /api/mentors, /api/mentor-requests", $techn="HTTP (proxy_pass :8080)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exeidentitysemester.IdentitySemesterAPI_1, DockerComposelocal.Dockerhost.exepostgres.identity_db_1, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exegroupmatching.GroupMatchingAPI_1, DockerComposelocal.Dockerhost.exepostgres.group_matching_db_1, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exementor.MentorAPI_1, DockerComposelocal.Dockerhost.exepostgres.mentor_db_1, "Creates schema + seed at startup (EnsureCreated)", $techn="EF Core / Npgsql, TCP 5432", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exeidentitysemester.IdentitySemesterAPI_1, DockerComposelocal.Dockerhost.exekafka.KafkaBroker_1, "Intended to publish StudentImportedEvent (publisher logs only; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exegroupmatching.GroupMatchingAPI_1, DockerComposelocal.Dockerhost.exekafka.KafkaBroker_1, "Intended to publish Group*/Leader/Topic events (stub; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exementor.MentorAPI_1, DockerComposelocal.Dockerhost.exekafka.KafkaBroker_1, "Intended to publish Mentor* events (stub; never called)", $techn="Kafka (stub)", $tags="", $link="")
Rel(DockerComposelocal.Dockerhost.exenotificationworker.NotificationWorker_1, DockerComposelocal.Dockerhost.exekafka.KafkaBroker_1, "Intended to consume events (TODO; no connection made)", $techn="Kafka (stub)", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml