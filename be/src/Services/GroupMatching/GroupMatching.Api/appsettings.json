{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=group_matching_db;Username=postgres;Password=postgres"
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka:29092",
    "GroupId": "group-matching-service"
  },
  "IdentitySemester": {
    "BaseUrl": "http://identity-semester:8080/"
  },
  "MentorGrpc": {
    "Address": "http://mentor:50051"
  },
  "Maintenance": {
    "OutboxCleanupIntervalSeconds": 60,
    "PublishedOutboxRetentionDays": 7
  },
  "JwtSettings": {
    "Secret": "replace-with-a-local-secret-at-least-32-bytes",
    "Issuer": "EXETeamMatching",
    "Audience": "EXETeamMatchingClients"
  }
}
