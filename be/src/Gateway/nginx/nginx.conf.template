worker_processes auto;

error_log /var/log/nginx/error.log warn;
pid       /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/json;

    # Logging format
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Hide nginx version
    server_tokens off;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/json text/plain text/css application/javascript;

    # Rate limiting zone
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;

    # DNS Resolver: 127.0.0.11 for Docker Compose internal DNS, 8.8.8.8 and 1.1.1.1 for Public DNS (Render/Cloud)
    # Using dynamic resolver + variables ensures Nginx NEVER crashes at boot if an upstream service is not deployed yet.
    resolver 127.0.0.11 8.8.8.8 1.1.1.1 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Shared proxy settings
    # The gateway owns browser CORS headers. Hide upstream headers to avoid
    # multiple Access-Control-Allow-Origin values, which browsers reject.
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;
    map $request_uri $proxy_host_header {
        default $host;
    }

    server {
        listen 80;
        server_name _;

        # Dynamic upstream URLs configured via environment variables or defaults
        set $identity_service "${IDENTITY_SERVICE_URL}";
        set $group_matching_service "${GROUP_MATCHING_SERVICE_URL}";
        set $mentor_service "${MENTOR_SERVICE_URL}";

        # Rate limiting
        limit_req zone=api_limit burst=50 nodelay;

        # Request size limit
        client_max_body_size 10m;

        # ─── CORS Configuration ───
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, X-Requested-With' always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # ─── Health Check ───

        location = / {
            return 200 '{"system":"EXE Team Matching API Gateway","status":"Online","version":"1.0.0","services":{"identity":"/api/auth, /api/students, /api/semesters","groups":"/api/groups, /api/matching","mentor":"/api/mentors, /api/mentor-requests"}}';
        }

        location = /health {
            return 200 '{"status":"Healthy"}';
        }

        # ─── Identity & Semester Service ───
        # Service 1 JWT verification via an internal authorization subrequest.
        location = /_identity_auth {
            internal;
            proxy_pass $identity_service/api/auth/validate;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Host $proxy_host;
            proxy_ssl_server_name on;
        }

        location /api/auth {
            proxy_pass $identity_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        # Large academic rosters can contain thousands of rows. Keep the longer
        # timeout scoped to this atomic import rather than weakening all APIs.
        location = /api/students/import/excel {
            auth_request /_identity_auth;
            proxy_pass $identity_service$request_uri;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;
            proxy_ssl_server_name on;
            proxy_connect_timeout 15s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
        }

        location /api/students {
            auth_request /_identity_auth;
            proxy_pass $identity_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        location /api/semesters {
            auth_request /_identity_auth;
            proxy_pass $identity_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        location /api/google-access {
            auth_request /_identity_auth;
            proxy_pass $identity_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        # ─── Group & Matching Service ───
        location /api/groups {
            proxy_pass $group_matching_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        location /api/matching {
            proxy_pass $group_matching_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        # ─── Mentor Service ───
        location /api/mentors {
            proxy_pass $mentor_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        location /api/mentor-requests {
            proxy_pass $mentor_service$request_uri;
            include /etc/nginx/proxy_params;
        }

        # ─── Block everything else ───
        location / {
            return 404 '{"error":"Not Found","message":"The requested endpoint does not exist. See / for available routes."}';
        }
    }
}
