# ==========================================
# EXE Team Matching System - Environment Variables Template (.env.example)
# ==========================================
# IMPORTANT: DO NOT put real production secrets in this file!
# Copy this file to '.env' and fill in your actual local/production environment values.

# ------------------------------------------
# Service Ports & Gateway
# ------------------------------------------
GATEWAY_PORT=8080
FRONTEND_PORT=3000
IDENTITY_PORT=5001
GROUP_MATCHING_PORT=5002
MENTOR_PORT=5003
MENTOR_GRPC_PORT=50051


# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=exe_matching_db

# Connection Strings used inside Docker network (microservice to postgres container)
IDENTITY_DB_CONNECTION=Host=postgres;Port=5432;Database=identity_db;Username=postgres;Password=your_postgres_password_here
GROUP_MATCHING_DB_CONNECTION=Host=postgres;Port=5432;Database=group_matching_db;Username=postgres;Password=your_postgres_password_here
MENTOR_DB_CONNECTION=Host=postgres;Port=5432;Database=mentor_db;Username=postgres;Password=your_postgres_password_here

# ------------------------------------------
# Messaging Broker (Apache Kafka)
# ------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ------------------------------------------
# Identity & JWT Configuration
# ------------------------------------------
# Must be a strong, random secret key (minimum 32 characters / 256 bits)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_chars_long
JWT_ISSUER=EXETeamMatching
JWT_AUDIENCE=EXETeamMatchingClients
JWT_EXPIRATION_IN_MINUTES=120

# ------------------------------------------
# Notification & Email Settings
# ------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_app_password_here
SENDER_EMAIL=noreply@exeteammatching.com
SENDER_NAME="EXE Team Matching System"
